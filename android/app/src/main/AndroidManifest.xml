<?xml version="1.0" encoding="utf-8"?>
<!-- jfinances for Android (docs/86-android.md): the app and its five widgets.
     The phone's token edits as the dashboard does (docs/40 §5). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sign-in opens a Custom Tab; Android 11+ only sees browsers it declares. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- ⚠ No backups and no device-to-device copies: the token is this phone's,
         and a restored phone signs in again (as iOS's ThisDeviceOnly). -->
    <application
        android:name=".JFinancesApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.JFinances"
        tools:targetApi="36">

        <!-- singleTask: the sign-in redirect and the widgets' links come back to
             the one activity, and close the Custom Tab above it. Portrait, as the
             iPhone app (Android 16 lifts it on tablets, which is fine). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- jfinances://linked?code=…&nonce=… (sign-in) and
                 jfinances://overview, ://account/<id>, ://insights/<section> … -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jfinances" />
            </intent-filter>
        </activity>

        <!-- A widget's options: show amounts, and which account. -->
        <activity
            android:name=".widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widgets.NetWorthReceiver"
            android:exported="true"
            android:label="@string/widget_net_worth">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_net_worth" />
        </receiver>
        <receiver
            android:name=".widgets.MonthReceiver"
            android:exported="true"
            android:label="@string/widget_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>
        <receiver
            android:name=".widgets.UpcomingReceiver"
            android:exported="true"
            android:label="@string/widget_upcoming">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming" />
        </receiver>
        <receiver
            android:name=".widgets.AccountReceiver"
            android:exported="true"
            android:label="@string/widget_account">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_account" />
        </receiver>
        <receiver
            android:name=".widgets.AccountsReceiver"
            android:exported="true"
            android:label="@string/widget_accounts">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_accounts" />
        </receiver>
    </application>
</manifest>
