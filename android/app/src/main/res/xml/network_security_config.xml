<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. Debug builds add 127.0.0.1 (src/debug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
